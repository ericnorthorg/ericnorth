# Базовые заголовки безопасности для статических страниц сайта.
# SAMEORIGIN: сайт (и админку) нельзя встроить в чужой сайт, а предпросмотр в своей админке работает.
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Манифест приложения админки: правильный тип файла (раньше отдавался как application/octet-stream)
/admin.webmanifest
  Content-Type: application/manifest+json
